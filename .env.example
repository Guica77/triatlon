# -----------------------------------------------------------------------------
# Triatlon Pro - Plantilla de Variables de Entorno (.env.example)
# Copia este archivo como .env.local para desarrollo local:
#   cp .env.example .env.local
# -----------------------------------------------------------------------------

# Supabase (Base de datos y autenticación de usuarios)
# Consigue estos valores en tu panel de Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-public-key-aqui
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-secret-key-aqui
NEXT_PUBLIC_SITE_URL=https://app.triwavex.com

# Sign in with Apple nativo: el client ID es el Bundle ID de la app iOS.
APPLE_CLIENT_ID=com.guillermohaya.triwavex
APPLE_CLIENT_SECRET=PEGA_AQUI_EL_CLIENT_SECRET_JWT_GENERADO_POR_APPLE
# App Store Server Notifications V2 (server-to-server purchases/refunds)
APPLE_BUNDLE_ID=com.guillermohaya.triwavex
APPLE_APP_ID=0000000000
APPLE_NOTIFICATION_ENV=sandbox
# Comma-separated base64 DER Apple root certificates; never expose publicly.
APPLE_ROOT_CERTS_BASE64=

# Autenticación de Google (OAuth 2.0)
# Configura las credenciales en Google Cloud Console para Login con Google
GOOGLE_CLIENT_ID=tu_client_id_de_google_aqui
GOOGLE_CLIENT_SECRET=tu_client_secret_de_google_aqui

# Strava API Credentials (OAuth 2.0 y telemetría de ritmos/actividades)
# Regístrate en https://www.strava.com/settings/api para obtener tus credenciales
STRAVA_CLIENT_ID=tu-strava-client-id-aqui
STRAVA_CLIENT_SECRET=tu-strava-client-secret-aqui
STRAVA_ACCESS_TOKEN=tu-token-temporal-aqui
STRAVA_REFRESH_TOKEN=tu-refresh-token-aqui

# IA - Google Gemini API (consulta las condiciones y límites vigentes del proveedor)
# Consigue tu API key gratis en https://aistudio.google.com/apikey
# Sin ella, las funciones de IA funcionan en modo offline con reglas expertas
GEMINI_API_KEY=tu-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Proveedores LLM compatibles con OpenAI (opcionales; free tier sujeto a límites vigentes)
# El router los prueba en este orden después de Gemini. Configura solo los que hayas
# verificado y cuyo tratamiento de datos sea compatible con tu consentimiento.
# GROQ_API_KEY=gsk_opcional
# GROQ_MODEL=llama-3.3-70b-versatile
# AION_API_KEY=opcional
# AION_MODEL=aion-labs/aion-2.0
# MISTRAL_API_KEY=opcional
# MISTRAL_MODEL=mistral-small-latest
# ZAI_API_KEY=opcional
# ZAI_MODEL=GLM-4.5-Flash
# HUGGINGFACE_API_KEY=opcional
# HUGGINGFACE_MODEL=meta-llama/Llama-3.1-8B-Instruct
# MODELSCOPE_API_KEY=opcional
# MODELSCOPE_MODEL=Qwen/Qwen3.5-35B-A3B
# NVIDIA_API_KEY=opcional
# NVIDIA_MODEL=openai/gpt-oss-20b
# OLLAMA_API_KEY=opcional
# OLLAMA_MODEL=gpt-oss:20b
# OPENROUTER_API_KEY=opcional
# OPENROUTER_MODEL=openai/gpt-oss-20b:free
# SILICONFLOW_API_KEY=opcional
# SILICONFLOW_MODEL=Qwen/Qwen3-8B
# OVHCLOUD_API_KEY=opcional
# OVHCLOUD_MODEL=openai/gpt-oss-20b
# KILO_API_KEY=opcional
# KILO_MODEL=openrouter/free
# LLM7_API_KEY=opcional
# LLM7_MODEL=gpt-oss:20b

# Cohere (API nativa v2; opcional)
# COHERE_API_KEY=opcional
# COHERE_MODEL=command-r

# Cloudflare Workers AI (API nativa; opcional)
# CLOUDFLARE_API_TOKEN=opcional
# CLOUDFLARE_ACCOUNT_ID=tu-account-id
# CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct

# Permite explícitamente gateways anónimos; puede exponer datos a terceros sin API key.
# AI_ENABLE_ANONYMOUS_GATEWAYS=false

# Opcional: Anthropic Claude como alternativa si prefieres
# ANTHROPIC_API_KEY=sk-ant-opcional
# ANTHROPIC_MODEL=claude-sonnet-5-20250601

# Resend API Credentials (Envío automático de correos)
# Se utiliza en los cron jobs / server actions para notificaciones y resúmenes
RESEND_API_KEY=tu-resend-api-key-aqui

# Vercel Cron (required in production)
CRON_SECRET=tu-cron-secret-aqui

# Administradores: UUID de cuentas autorizadas, separados por comas. Vacío deniega acceso.
ADMIN_USER_IDS=
# Clave privada de 32 bytes en hexadecimal para cifrar tokens Apple. No usar NEXT_PUBLIC_.
# Generar una sola vez y conservar de forma segura; cambiarla requiere renovar tokens.
TOKEN_ENCRYPTION_KEY=
# Dirección real de soporte, visible públicamente. Configurar también en la web pública.
SUPPORT_EMAIL=support@triwavex.com
